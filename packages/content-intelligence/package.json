{
  "name": "@forge/content-intelligence",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc",
    "dev": "node ../../node_modules/typescript/bin/tsc --watch",
