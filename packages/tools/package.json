{
  "name": "@forge/tools",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./html-parser": {
      "types": "./dist/html-parser/index.d.ts",
      "import": "./dist/html-parser/index.js"
    },
    "./website-reader": {
      "types": "./dist/website-reader/index.d.ts",
      "import": "./dist/website-reader/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "del /q dist 2>nul || rmdir /s /q dist"
  },
  "dependencies": {
    "@forge/core": "workspace:*",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "zod": "^3.25.76"
  }
}
