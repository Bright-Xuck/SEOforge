{
  "name": "@forge/dom-engine",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc",
    "dev": "node ../../node_modules/typescript/bin/tsc --watch",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "clean": "del /q dist 2>nul || rmdir /s /q dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@forge/ai-engine": "workspace:*",
    "@forge/content-intelligence": "workspace:*",
    "@forge/content-generation": "workspace:*",
    "@forge/core": "workspace:*",
    "@forge/execution-engine": "workspace:*",
    "@forge/knowledge-engine": "workspace:*",
    "@forge/prompt-registry": "workspace:*",
    "@forge/review-engine": "workspace:*",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "@types/cheerio": "^1.0.0",
    "vitest": "^3.2.7"
  }
}
