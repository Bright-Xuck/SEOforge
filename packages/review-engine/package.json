{
  "name": "@forge/review-engine",
  "version": "0.18.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc",
    "dev": "node ../../node_modules/typescript/bin/tsc --watch",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node ../../node_modules/vitest/vitest.mjs run packages/review-engine"
  },
  "dependencies": {
    "@forge/content-generation": "workspace:*",
    "@forge/knowledge-engine": "workspace:*",
    "@forge/memory-engine": "workspace:*"
  }
}
