{
  "name": "@forge/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "forge": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc",
    "dev": "node ../../node_modules/typescript/bin/tsc --watch",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "clean": "del /q dist 2>nul || rmdir /s /q dist"
  },
  "dependencies": {
    "@forge/action-engine": "workspace:*",
    "@forge/ai-engine": "workspace:*",
    "@forge/agent-engine": "workspace:*",
    "@forge/context-builder": "workspace:*",
    "@forge/capabilities": "workspace:*",
    "@forge/config": "workspace:*",
    "@forge/content-generation": "workspace:*",
    "@forge/content-intelligence": "workspace:*",
    "@forge/core": "workspace:*",
    "@forge/dom-engine": "workspace:*",
    "@forge/execution-engine": "workspace:*",
    "@forge/homepage-engine": "workspace:*",
    "@forge/logger": "workspace:*",
    "@forge/knowledge-engine": "workspace:*",
    "@forge/memory-engine": "workspace:*",
    "@forge/mission-engine": "workspace:*",
    "@forge/optimization-orchestrator": "workspace:*",
    "@forge/project-resolver": "workspace:*",
    "@forge/pipeline-engine": "workspace:*",
    "@forge/preflight-validator": "workspace:*",
    "@forge/prompt-registry": "workspace:*",
    "@forge/providers-wordpress": "workspace:*",
    "@forge/recommendation-engine": "workspace:*",
    "@forge/review-engine": "workspace:*",
    "@forge/strategy-engine": "workspace:*",
    "@forge/skills": "workspace:*",
    "@forge/shared": "workspace:*",
    "@forge/tools": "workspace:*",
    "cheerio": "^1.0.0",
    "commander": "^15.0.0"
  }
}
