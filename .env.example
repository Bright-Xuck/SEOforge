# Forge environment template.
#
# Copy this file to `.env` for local development:
#   PowerShell: Copy-Item .env.example .env
#   bash:       cp .env.example .env
#
# Values already exported in your shell or CI environment take precedence over
# this file. Never commit `.env` or put real secrets in this example file.

# Optional: alternate dotenv path. Defaults to `.env` in the current directory.
# FORGE_ENV_FILE=.env

# ---------------------------------------------------------------------------
# WordPress (required for reads/writes through the WordPress provider)
# ---------------------------------------------------------------------------
# Use the site root, including http:// for local development.
FORGE_WP_SITE_URL=http://127.0.0.1:8080
FORGE_WP_USERNAME=your-wordpress-username
# Create this in WordPress: Users -> Profile -> Application Passwords.
# Use the generated 24-character value, not your normal login password.
# Leave the value empty in this template; set it only in your local `.env`.
FORGE_WP_APPLICATION_PASSWORD=

# Optional homepage/site URL override for deterministic content analysis.
# Defaults to FORGE_WP_SITE_URL when empty.
# FORGE_HOME_URL=http://127.0.0.1:8080

# Staging page used by the Elementor end-to-end workflow.
# Replace 123 with a real page/post id; a media attachment id is not valid.
FORGE_WP_PAGE_ID=123

# ---------------------------------------------------------------------------
# AI providers (at least one is needed for AI section generation)
# ---------------------------------------------------------------------------
# Z.ai is the verified live provider. glm-4.5-flash is the tested default.
ZAI_API_KEY=
# DEFAULT_PROVIDER=zai
# DEFAULT_MODEL=glm-4.5-flash

# Optional alternatives.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Local Ollama endpoint.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Shared generation limits.
TEMPERATURE=0.7
MAX_TOKENS=4096
TIMEOUT=30000
MAX_RETRIES=3
RETRY_DELAY=1000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
FORGE_LOG_LEVEL=info
FORGE_LOG_TIMESTAMPS=true
FORGE_LOG_OUTPUT=stdout

# ---------------------------------------------------------------------------
# Opt-in live integration tests (never required for unit tests)
# ---------------------------------------------------------------------------
FORGE_WP_INTEGRATION=false
# FORGE_WP_URL=http://127.0.0.1:8080
# FORGE_WP_USER=forge
# FORGE_WP_APP_PASSWORD=
