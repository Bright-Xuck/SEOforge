{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "AI Operating System for Websites",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "vitest run",
    "lint": "eslint .",
    "check:deps": "node scripts/audit-unused-deps.mjs --strict",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.25.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
